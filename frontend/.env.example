# SkyOps backend API (see backend/app/main.py) - the frontend never talks to the LLM gateway or
# LangGraph directly, only through the backend's HTTP API.
SKYOPS_API_BASE_URL=http://localhost:8000

# Must match SKYOPS_API_KEY in backend/.env - the backend's AuthMiddleware requires it on
# /chat/message.
SKYOPS_API_KEY=
