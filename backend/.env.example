# LiteLLM proxy (see litellm-proxy/config.yaml) - all LLM calls go through this, never a provider directly.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=primary

# HTTP API auth (see app/middleware/auth.py). SKYOPS_API_KEY is required on every route except
# /health/docs; /ops/* additionally requires SKYOPS_OPS_API_KEY, so a leaked customer-chat key
# alone can't reach the internal approval endpoints.
SKYOPS_API_KEY=
SKYOPS_OPS_API_KEY=
